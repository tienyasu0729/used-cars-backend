# Backend Docker env template — copy to .env and fill secrets before `docker run`.
# Flyway runs V7+ migrations (otp_verification_id on InstallmentApplications).
# Legacy DBs are baselined automatically via FlywayLegacyBaselineConfig (baseline-version 6).

JAVA_OPTS=-Xms512m -Xmx1024m
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
APP_TIMEZONE=Asia/Saigon

DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=usedCars
DB_USERNAME=sa
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_TIMEOUT=2000ms

FLYWAY_ENABLED=true
FLYWAY_BASELINE_VERSION=6
PAYMENT_LOG_LEVEL=INFO
OTP_LOG_LEVEL=WARN
SMS_LOG_LEVEL=WARN

CORS_ALLOWED_ORIGIN_1=https://otocudanang.store
CORS_ALLOWED_ORIGIN_2=https://www.otocudanang.store
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SSL_TRUST=smtp.gmail.com
MAIL_SSL_PROTOCOLS=TLSv1.2

APP_JWT_SECRET=change-me-to-a-256-bit-secret
APP_JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DOCS_CLOUD_NAME=
CLOUDINARY_DOCS_API_KEY=
CLOUDINARY_DOCS_API_SECRET=

CREDIT_SERVICE_URL=https://credit-service-n2s5.onrender.com/api/loan/apply
CREDIT_SERVICE_STATUS_ENDPOINT=https://credit-service-n2s5.onrender.com/api/loan/status
CREDIT_SERVICE_API_KEY=
CREDIT_SERVICE_SECRET=
CREDIT_SERVICE_API_SECRET=
CREDIT_SERVICE_TIMEOUT_MS=10000
CREDIT_SERVICE_CONNECT_TIMEOUT_MS=3000
CREDIT_SERVICE_RETRY_FIXED_DELAY_MS=15000
CREDIT_SERVICE_RETRY_BASE_DELAY_MS=5000
CREDIT_SERVICE_RETRY_MAX_DELAY_MS=900000
CREDIT_SERVICE_RETRY_BATCH_SIZE=20

ORDER_PENDING_TIMEOUT_HOURS=24
INSTALLMENT_PRE_DEPOSIT_PERCENT=10

PAYMENT_FRONTEND_BASE_URL=https://otocudanang.store
VNPAY_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://api.otocudanang.store/api/v1/payment/vnpay/return
VNPAY_IPN_URL=https://api.otocudanang.store/api/v1/payment/vnpay/ipn
VNPAY_MERCHANT_API_URL=
VNPAY_CUSTOMER_IP_FALLBACK=
VNPAY_ORDER_TYPE=
VNPAY_HMAC_ALGORITHM=

ZALOPAY_ENABLED=true
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=https://api.otocudanang.store/api/v1/payment/zalopay/callback

SMS_ENABLED=true
SMS_REQUIRE_HTTPS=true

PRICING_ENABLED=false
PRICING_BASE_URL=http://host.docker.internal:8000
PRICING_ESTIMATE_PATH=/internal/vehicle-pricing/estimate
PRICING_INTERNAL_TOKEN=pricing_internal_local_token
PRICING_CONNECT_TIMEOUT_MS=15000
PRICING_READ_TIMEOUT_MS=600000
