# Backend Docker env template — copy to docker/.env.backend and fill secrets before `docker run`.
# For VPS/systemd production, copy docker/.env.prod.example locally (gitignored) as your filled .env.
# Flyway runs V7+ migrations (otp_verification_id on InstallmentApplications).
# Legacy DBs are baselined automatically via FlywayLegacyBaselineConfig (baseline-version 6).

JAVA_OPTS=-Xms512m -Xmx1024m
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
APP_TIMEZONE=Asia/Saigon

DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=usedCars
DB_USERNAME=sa
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_TIMEOUT=2000ms

FLYWAY_ENABLED=true
FLYWAY_BASELINE_VERSION=6
PAYMENT_LOG_LEVEL=INFO
OTP_LOG_LEVEL=WARN
SMS_LOG_LEVEL=WARN

CORS_ALLOWED_ORIGIN_1=https://example.com
CORS_ALLOWED_ORIGIN_2=https://www.example.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=change-me@example.com
MAIL_SSL_TRUST=smtp.gmail.com
MAIL_SSL_PROTOCOLS=TLSv1.2

APP_JWT_SECRET=change-me-to-a-256-bit-secret
APP_JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=change-me

CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
CLOUDINARY_DOCS_CLOUD_NAME=change-me
CLOUDINARY_DOCS_API_KEY=change-me
CLOUDINARY_DOCS_API_SECRET=change-me

CREDIT_SERVICE_URL=https://example.com/api/loan/apply
CREDIT_SERVICE_STATUS_ENDPOINT=https://example.com/api/loan/status
CREDIT_SERVICE_API_KEY=change-me
CREDIT_SERVICE_SECRET=change-me
CREDIT_SERVICE_API_SECRET=change-me
CREDIT_SERVICE_TIMEOUT_MS=10000
CREDIT_SERVICE_CONNECT_TIMEOUT_MS=3000
CREDIT_SERVICE_RETRY_FIXED_DELAY_MS=15000
CREDIT_SERVICE_RETRY_BASE_DELAY_MS=5000
CREDIT_SERVICE_RETRY_MAX_DELAY_MS=900000
CREDIT_SERVICE_RETRY_BATCH_SIZE=20

ORDER_PENDING_TIMEOUT_HOURS=24
INSTALLMENT_PRE_DEPOSIT_PERCENT=10
INSTALLMENT_CONTRACT_PAYMENT_DAY_OF_MONTH=15
INSTALLMENT_CONTRACT_LATE_FEE_RATE_PERCENT=change-me
INSTALLMENT_CONTRACT_SELLER_COMPANY_NAME=change-me
INSTALLMENT_CONTRACT_SELLER_TAX_CODE=change-me
INSTALLMENT_CONTRACT_SELLER_ADDRESS=change-me
INSTALLMENT_CONTRACT_SELLER_REPRESENTATIVE=change-me

PAYMENT_FRONTEND_BASE_URL=https://example.com
VNPAY_ENABLED=true
VNPAY_TMN_CODE=change-me
VNPAY_HASH_SECRET=change-me
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://example.com/api/v1/payment/vnpay/return
VNPAY_IPN_URL=https://example.com/api/v1/payment/vnpay/ipn
VNPAY_MERCHANT_API_URL=change-me
VNPAY_CUSTOMER_IP_FALLBACK=change-me
VNPAY_ORDER_TYPE=change-me
VNPAY_HMAC_ALGORITHM=change-me

ZALOPAY_ENABLED=true
ZALOPAY_APP_ID=change-me
ZALOPAY_KEY1=change-me
ZALOPAY_KEY2=change-me
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=https://example.com/api/v1/payment/zalopay/callback

SMS_ENABLED=true
SMS_REQUIRE_HTTPS=true

PRICING_ENABLED=false
PRICING_BASE_URL=http://host.docker.internal:8000
PRICING_ESTIMATE_PATH=/internal/vehicle-pricing/estimate
PRICING_INTERNAL_TOKEN=change-me
PRICING_CONNECT_TIMEOUT_MS=15000
PRICING_READ_TIMEOUT_MS=600000
